# Copy to .env next to compose.yml and fill in. Keep .env readable only by you (chmod 600 .env).

# This machine's office LAN address. Script 1 of the setup wrote it to /home/paperclip/setup/lan.env.
LAN_IP=192.168.1.50

# The address people and apps use to reach GlitchTip. Include the scheme and the port.
GLITCHTIP_DOMAIN=http://your-machine-name.local:8000

# Generate each with: openssl rand -hex 32
GLITCHTIP_SECRET_KEY=
POSTGRES_PASSWORD=

# Optional. Without an SMTP server, GlitchTip writes emails to its log; alerts still reach Paperclip by webhook.
# GLITCHTIP_EMAIL_URL=smtp://user:password@smtp.example.com:587
# GLITCHTIP_FROM_EMAIL=glitchtip@example.com

# Optional. Pin a GlitchTip release (for example 6.2) instead of the latest 6.x.
# GLITCHTIP_VERSION=6
